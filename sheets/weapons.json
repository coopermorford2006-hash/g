{
  "sheet": "weapons",
  "about": "One row per Fortnite gun. Damage is Fortnite's per-shot body damage by rarity [common, uncommon, rare, epic, legendary]; the DLL multiplies it by the region tier where the gun was found (region_tiers.damage_mult) before it reaches Elden Ring. Values are Fortnite's classic loot-pool numbers (Fortnite wiki), chosen as design values.",
  "columns": {
    "id": "stable key used by code and other sheets",
    "name": "display name on the HUD",
    "class": "fire behaviour family: rifle | shotgun | smg | sniper | pistol | launcher",
    "ammo": "@ammo row",
    "damage": "body damage per shot (shotgun: whole shot) by rarity, 5 numbers",
    "headshot_mult": "headshot multiplier",
    "pellets": "projectiles per shot",
    "fire_rate": "shots per second",
    "auto": "true = hold to fire",
    "mag": "magazine size",
    "reload_s": "reload time in seconds by rarity, 5 numbers",
    "reload_per_shell": "true = reloads one round at a time (pump)",
    "range_m": "max effective range in metres (bullet life)",
    "falloff_start_m": "distance where damage starts to drop",
    "falloff_min": "damage fraction at range_m",
    "spread_hip_deg": "cone half-angle hip fire",
    "spread_ads_deg": "cone half-angle aiming down sights",
    "bloom_per_shot_deg": "spread added per shot",
    "recoil_pitch_deg": "camera kick per shot",
    "bullet_speed_mps": "projectile speed (hitscan guns use a fast engine bullet)",
    "explosion_radius_m": "0 = no splash",
    "build_damage_mult": "multiplier against player builds",
    "ads_fov": "camera FOV while aiming",
    "rarities": "which rarities can drop: list of @rarities ids",
    "fn_mesh": "@fortnite_assets row for the weapon mesh",
    "fn_icon": "@fortnite_assets row for the HUD icon",
    "fn_fire_sound": "@fortnite_assets row",
    "fn_reload_sound": "@fortnite_assets row",
    "anim_set": "@animations group for fire/reload"
  },
